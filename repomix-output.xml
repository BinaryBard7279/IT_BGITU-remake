    pool_size=20, 
    max_overflow=10
)

setup_db_profiling(engine) 

AsyncSessionLocal = sessionmaker(
    engine, 
    class_=AsyncSession, 
    expire_on_commit=False
)


async def get_db():
    async with AsyncSessionLocal() as session:
        yield session
