/* Скругления */
.roadmap-cell.start { border-top-left-radius: 0.5rem; border-bottom-left-radius: 0.5rem; margin-left: 2px; }
.roadmap-cell.end { border-top-right-radius: 0.5rem; border-bottom-right-radius: 0.5rem; margin-right: 2px; }
.roadmap-cell.start.end { border-radius: 0.5rem; }

/* Маркеры годов обучения */
.year-markers { 
    display: grid; 
    grid-template-columns: 160px repeat(4, 1fr); 
    gap: 1rem; 
    margin-top: 1.5rem; 
    padding-top: 1rem; 
    border-top: 1px solid var(--border); 
}
.year-marker { text-align: center; font-size: 0.875rem; color: var(--muted-foreground); }
.year-marker:nth-child(2) { grid-column: 2 / 4; }
.year-marker:nth-child(3) { grid-column: 4 / 6; }
.year-marker:nth-child(4) { grid-column: 6 / 8; }
.year-marker:nth-child(5) { grid-column: 8 / 10; }

.course-tooltip { display: none; position: fixed; top: 1rem; right: 1rem; z-index: 50; padding: 1rem; background-color: var(--card); border: 1px solid var(--border); border-radius: 0.75rem; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1); max-width: 18rem; animation: scaleIn 0.2s ease-out; pointer-events: none;}
.year-markers { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border); }
.year-marker { text-align: center; font-size: 0.875rem; color: var(--muted-foreground); }

.course-tooltip { display: none; position: fixed; top: 1rem; right: 1rem; z-index: 50; padding: 1rem; background-color: var(--card); border: 1px solid var(--border); border-radius: 0.75rem; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1); max-width: 18rem; animation: scaleIn 0.2s ease-out; }
.tooltip-icon { width: 2rem; height: 2rem; border-radius: 0.5rem; margin-bottom: 0.75rem; }
.tooltip-title { font-weight: 600; margin-bottom: 0.25rem; }
.tooltip-description { font-size: 0.875rem; color: var(--muted-foreground); margin-bottom: 0.5rem; line-height: 1.5; }
.tooltip-meta { font-size: 0.75rem; color: var(--muted-foreground); }

/* ================= TIMELINE ================= */
.timeline-wrapper { position: relative; max-width: 800px; margin: 0 auto; padding: 1rem 0; }
.timeline-line { position: absolute; left: 24px; top: 0; bottom: 0; width: 2px; background-color: var(--border); z-index: 0; }
.timeline-item { position: relative; padding-left: 80px; margin-bottom: 3rem; z-index: 1; }
.timeline-item:last-child { margin-bottom: 0; }
.timeline-marker {
  position: absolute; left: 0; top: 0; width: 48px; height: 48px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 1.125rem;
  border: 4px solid var(--background); box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  transition: transform var(--transition);
}
.timeline-item:hover .timeline-marker { transform: scale(1.1); }
.timeline-content { padding: 1.5rem; position: relative; }
.timeline-content::before {
  content: ''; position: absolute; left: -6px; top: 20px; width: 10px; height: 10px;
  background-color: var(--card); border-left: 1px solid var(--border); border-bottom: 1px solid var(--border);
  transform: rotate(45deg);
}
.timeline-term { display: inline-block; font-size: 0.75rem; font-weight: 600; color: var(--muted-foreground); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
.timeline-heading { font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem; }
.timeline-desc { font-size: 0.9375rem; color: var(--muted-foreground); }

@media (max-width: 640px) {
  .timeline-line { left: 16px; }
  .timeline-marker { width: 32px; height: 32px; font-size: 0.875rem; border-width: 3px; }
  .timeline-item { padding-left: 50px; }
}

/* ================= ДОСТИЖЕНИЯ ================= */
.achievements-grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
.achievement-card { padding: 1.5rem; position: relative; border-top-width: 4px; }
.achievement-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; }
.achievement-tag { font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.75rem; border-radius: 9999px; text-transform: uppercase; letter-spacing: 0.05em; }
.achievement-title { font-size: 1.125rem; font-weight: 700; margin-bottom: 0.5rem; line-height: 1.3; }
.achievement-desc { font-size: 0.875rem; color: var(--muted-foreground); }
.border-sky { border-top-color: var(--pastel-sky); }
.border-mint { border-top-color: var(--pastel-mint); }
.border-peach { border-top-color: var(--pastel-peach); }
.border-lavender { border-top-color: var(--pastel-lavender); }

/* ================= FAQ & FORM ================= */
.apply-grid { display: grid; gap: 3rem; }
@media (min-width: 900px) { .apply-grid { grid-template-columns: 1fr 1fr; align-items: start; } }
.faq-column { display: flex; flex-direction: column; gap: 1rem; }
.faq-question { width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 1.25rem; text-align: left; font-size: 1rem; font-weight: 600; transition: color 0.2s ease; }
.faq-question:hover { color: var(--primary); }
.faq-icon { font-weight: 400; font-size: 1.5rem; color: var(--muted-foreground); transition: transform var(--transition); }
.faq-item.active .faq-icon { transform: rotate(45deg); color: var(--primary); }
.faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.5s ease-in-out; background-color: rgba(255,255,255,0.5); }
.faq-answer p { padding: 0 1.25rem 1.25rem; font-size: 0.9375rem; color: var(--muted-foreground); }

.apply-form { padding: 2rem; box-shadow: 0 10px 40px -10px rgba(0,0,0,0.05); }
.form-header { margin-bottom: 1.5rem; }
.form-title { font-size: 1.25rem; font-weight: 700; margin-bottom: 0.25rem; }
.form-subtitle { font-size: 0.875rem; color: var(--muted-foreground); }
.form-group { margin-bottom: 1rem; }
.form-input, .form-select { width: 100%; padding: 0.75rem 1rem; font-size: 0.9375rem; font-family: inherit; background-color: var(--background); border: 1px solid var(--border); border-radius: var(--radius); outline: none; transition: border-color 0.2s ease, box-shadow 0.2s ease; }
.form-input:focus, .form-select:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(0,0,0,0.05); }
.form-success { margin-top: 1rem; padding: 1rem; background-color: var(--pastel-mint); border-radius: var(--radius); display: flex; align-items: center; gap: 0.75rem; color: #064e3b; font-weight: 500; font-size: 0.9375rem; animation: fadeInUp 0.4s ease; }

.footer { padding: 4rem 0; background-color: var(--card); border-top: 1px solid var(--border); }
.footer-grid { display: grid; gap: 3rem; }
@media (min-width: 768px) { .footer-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .footer-grid { grid-template-columns: repeat(4, 1fr); } }
.footer-section { display: flex; flex-direction: column; gap: 1rem; }
.footer-brand { font-size: 1.25rem; font-weight: 600; }
.footer-description { font-size: 0.875rem; color: var(--muted-foreground); }
.footer-cta { margin-top: 0.5rem; align-self: flex-start; }
.footer-heading { font-size: 0.875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }
.footer-contacts, .footer-links { display: flex; flex-direction: column; gap: 0.75rem; }
.footer-links { gap: 0.5rem; }
.footer-contact, .footer-links a, .footer-social { display: flex; align-items: center; gap: 0.75rem; font-size: 0.875rem; color: var(--muted-foreground); transition: color 0.2s ease; }
.footer-contact a:hover, .footer-links a:hover, .footer-social:hover { color: var(--foreground); }
.footer-squares { display: flex; gap: 0.5rem; padding-top: 1rem; }
.footer-square { width: 2rem; height: 2rem; }
.footer-bottom { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border); text-align: center; }
.footer-copyright { font-size: 0.875rem; color: var(--muted-foreground); }
</file>

